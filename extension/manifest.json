{
  "manifest_version": 3,
  "name": "WebSense MCP Bridge",
  "description": "Semantic Action Graph extraction for AI web automation \u2014 no vision, no CDP, no bot detection",
  "version": "1.4.7",
  "permissions": [
    "tabs",
    "storage",
    "offscreen",
    "scripting",
    "userScripts",
    "webNavigation",
    "downloads",
    "clipboardRead",
    "clipboardWrite",
    "alarms",
    "cookies",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "js": [
        "websense-cs.js"
      ],
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "WebSense MCP \u2014 Click for status",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
